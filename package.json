{
  "name": "youtube-trend-radar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:db": "node --env-file=.env.local scripts/check-db.mjs",
    "collect:test": "node --env-file=.env.local --conditions=react-server --import tsx scripts/collect-test.ts",
    "score:test": "node --env-file=.env.local --conditions=react-server --import tsx scripts/score-test.ts",
    "themes:test": "node --env-file=.env.local --conditions=react-server --import tsx scripts/themes-test.ts",
    "check:gemini": "node --env-file=.env.local scripts/check-gemini.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@neondatabase/serverless": "^1.2.0",
    "fast-xml-parser": "^5.11.2",
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
