# Copy this file to .env.local and fill in real values.
# Never commit .env.local. Every value below is read only in server code.

# YouTube Data API v3 key (Google Cloud Console > APIs & Services > Credentials)
YOUTUBE_API_KEY=

# Gemini Flash (Google AI Studio)
GEMINI_API_KEY=
# Checked 2026-10-11 at https://ai.google.dev/gemini-api/docs/models (page updated 2026-10-09):
# gemini-3.8-flash is the newest stable Flash model. Only Flash models are allowed in this app.
GEMINI_MODEL=gemini-3.8-flash

# Neon Postgres connection string (Neon console > project youtube-trend-radar > Connect).
# Use the pooled connection string. Server only: it contains the database password.
DATABASE_URL=

# Resend email
RESEND_API_KEY=
BRIEF_FROM_EMAIL=onboarding@resend.dev
BRIEF_TO_EMAIL=

# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" on cron requests
CRON_SECRET=

# Protects the Settings page and the manual run button
ADMIN_PASSWORD=

# Public URL of the deployed app, used for links in the email
APP_URL=http://localhost:3000

# Confirm both limits for your project in Google Cloud Console > Quotas.
# General units per day (videos.list, channels.list, ...). See docs/quota.md.
YOUTUBE_DAILY_QUOTA=10000
# search.list has its own bucket: calls per day (default 100 as of 2026-10-08).
YOUTUBE_SEARCH_DAILY_LIMIT=100
# Use at most this fraction of each daily bucket per run
QUOTA_SAFETY_MARGIN=0.5
