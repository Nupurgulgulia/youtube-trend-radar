# Copy this file to .env.local and fill in real values.
# Never commit .env.local. Every value below is read only in server code.

# YouTube Data API v3 key (Google Cloud Console > APIs & Services > Credentials)
YOUTUBE_API_KEY=

# Gemini Flash (Google AI Studio)
GEMINI_API_KEY=
# Not filled in yet: the current Flash model ID will be checked against the
# official Gemini docs before the first AI call (checkpoint 6).
GEMINI_MODEL=

# Supabase (Project Settings > API). The service-role key is server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend email
RESEND_API_KEY=
BRIEF_FROM_EMAIL=onboarding@resend.dev
BRIEF_TO_EMAIL=

# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" on cron requests
CRON_SECRET=

# Protects the Settings page and the manual run button
ADMIN_PASSWORD=

# Public URL of the deployed app, used for links in the email
APP_URL=http://localhost:3000

# Confirm the daily quota for your project in Google Cloud Console
YOUTUBE_DAILY_QUOTA=10000
# Use at most this fraction of the daily quota per run
QUOTA_SAFETY_MARGIN=0.5
